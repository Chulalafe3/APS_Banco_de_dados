digraph DER {
graph [rankdir=LR, nodesep=0.35, ranksep=0.9, fontname="Helvetica", splines=true, bgcolor="white"];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#4F616E", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.7, penwidth=1.1];
cliente [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#D9E8F5" colspan="2"><b>cliente</b></td></tr><tr><td align="left" port="id_cliente"><font color="#8A5A00">PK </font><b>id_cliente</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="nome">nome</td><td align="left"><font color="#5E6E7A">varchar(100)</font></td></tr><tr><td align="left" port="cidade">cidade</td><td align="left"><font color="#5E6E7A">varchar(80)</font></td></tr><tr><td align="left" port="uf">uf</td><td align="left"><font color="#5E6E7A">char(2)</font></td></tr><tr><td align="left" port="data_cadastro">data_cadastro</td><td align="left"><font color="#5E6E7A">date</font></td></tr></table>>];
dispositivo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#D9E8F5" colspan="2"><b>dispositivo</b></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">PK </font><b>id_dispositivo</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="id_cliente"><font color="#8A5A00">FK </font>id_cliente</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="nome">nome</td><td align="left"><font color="#5E6E7A">varchar(100)</font></td></tr><tr><td align="left" port="intervalo_leitura_min">intervalo_leitura_min</td><td align="left"><font color="#5E6E7A">smallint</font></td></tr><tr><td align="left" port="intervalo_transmissao_min">intervalo_transmissao_min</td><td align="left"><font color="#5E6E7A">smallint</font></td></tr><tr><td align="left" port="latitude">latitude</td><td align="left"><font color="#5E6E7A">numeric(9,6)</font></td></tr><tr><td align="left" port="longitude">longitude</td><td align="left"><font color="#5E6E7A">numeric(9,6)</font></td></tr><tr><td align="left" port="ativo">ativo</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#5E6E7A">varchar(12)</font></td></tr><tr><td align="left" port="ultima_comunicacao">ultima_comunicacao</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="simulado">simulado</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr><tr><td align="left" port="ajuste_temperatura_sim">ajuste_temperatura_sim</td><td align="left"><font color="#5E6E7A">numeric(4,2)</font></td></tr><tr><td align="left" port="chave_api_hash">chave_api_hash</td><td align="left"><font color="#5E6E7A">bytea</font></td></tr></table>>];
sensor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#D9E8F5" colspan="2"><b>sensor</b></td></tr><tr><td align="left" port="id_sensor"><font color="#8A5A00">PK </font><b>id_sensor</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">FK </font>id_dispositivo</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="parametro">parametro</td><td align="left"><font color="#5E6E7A">varchar(30)</font></td></tr><tr><td align="left" port="unidade">unidade</td><td align="left"><font color="#5E6E7A">varchar(10)</font></td></tr><tr><td align="left" port="limite_min">limite_min</td><td align="left"><font color="#5E6E7A">numeric</font></td></tr><tr><td align="left" port="limite_max">limite_max</td><td align="left"><font color="#5E6E7A">numeric</font></td></tr><tr><td align="left" port="ativo">ativo</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr></table>>];
leitura [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#DCEFE3" colspan="2"><b>leitura</b></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">PK FK </font><b>id_dispositivo</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="data_hora"><font color="#8A5A00">PK </font><b>data_hora</b></td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="temperatura_ar">temperatura_ar</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="umidade_ar">umidade_ar</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="chuva">chuva</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="chuva_acumulada">chuva_acumulada</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="direcao_vento">direcao_vento</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="velocidade_vento">velocidade_vento</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="radiacao_solar">radiacao_solar</td><td align="left"><font color="#5E6E7A">numeric(8,2)</font></td></tr><tr><td align="left" port="recebido_em">recebido_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr></table>>];
leitura_arquivo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#DCEFE3" colspan="2"><b>leitura_arquivo</b></td></tr><tr><td align="left" colspan="2"><i>mesma estrutura de leitura</i></td></tr><tr><td align="left" port="id_dispositivo">PK FK id_dispositivo</td><td align="left">integer</td></tr></table>>];
leitura_diaria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#DCEFE3" colspan="2"><b>leitura_diaria</b></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">PK FK </font><b>id_dispositivo</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="dia"><font color="#8A5A00">PK </font><b>dia</b></td><td align="left"><font color="#5E6E7A">date</font></td></tr><tr><td align="left" port="temp_min">temp_min</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="temp_max">temp_max</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="temp_media">temp_media</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="umidade_min">umidade_min</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="umidade_max">umidade_max</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="umidade_media">umidade_media</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="chuva_total">chuva_total</td><td align="left"><font color="#5E6E7A">numeric(7,2)</font></td></tr><tr><td align="left" port="vento_media">vento_media</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="vento_max">vento_max</td><td align="left"><font color="#5E6E7A">numeric(5,2)</font></td></tr><tr><td align="left" port="vento_dir_predominante">vento_dir_predominante</td><td align="left"><font color="#5E6E7A">numeric(5,1)</font></td></tr><tr><td align="left" port="radiacao_media">radiacao_media</td><td align="left"><font color="#5E6E7A">numeric(7,2)</font></td></tr><tr><td align="left" port="radiacao_max">radiacao_max</td><td align="left"><font color="#5E6E7A">numeric(7,2)</font></td></tr><tr><td align="left" port="qtd_leituras">qtd_leituras</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="qtd_valores_invalidos">qtd_valores_invalidos</td><td align="left"><font color="#5E6E7A">integer</font></td></tr></table>>];
regra_alarme [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#D9E8F5" colspan="2"><b>regra_alarme</b></td></tr><tr><td align="left" port="id_regra"><font color="#8A5A00">PK </font><b>id_regra</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">FK </font>id_dispositivo</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="parametro">parametro</td><td align="left"><font color="#5E6E7A">varchar(30)</font></td></tr><tr><td align="left" port="condicao">condicao</td><td align="left"><font color="#5E6E7A">varchar(6)</font></td></tr><tr><td align="left" port="limite">limite</td><td align="left"><font color="#5E6E7A">numeric</font></td></tr><tr><td align="left" port="nivel">nivel</td><td align="left"><font color="#5E6E7A">varchar(10)</font></td></tr><tr><td align="left" port="nota">nota</td><td align="left"><font color="#5E6E7A">varchar(150)</font></td></tr><tr><td align="left" port="ativo">ativo</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr></table>>];
evento [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#FBE7D3" colspan="2"><b>evento</b></td></tr><tr><td align="left" port="id_evento"><font color="#8A5A00">PK </font><b>id_evento</b></td><td align="left"><font color="#5E6E7A">bigint</font></td></tr><tr><td align="left" port="id_dispositivo"><font color="#8A5A00">FK </font>id_dispositivo</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="data_hora">data_hora</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="tipo">tipo</td><td align="left"><font color="#5E6E7A">varchar(20)</font></td></tr><tr><td align="left" port="parametro">parametro</td><td align="left"><font color="#5E6E7A">varchar(30)</font></td></tr><tr><td align="left" port="valor">valor</td><td align="left"><font color="#5E6E7A">numeric</font></td></tr><tr><td align="left" port="id_regra"><font color="#8A5A00">FK </font>id_regra</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="mensagem">mensagem</td><td align="left"><font color="#5E6E7A">varchar(250)</font></td></tr><tr><td align="left" port="reconhecido">reconhecido</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr><tr><td align="left" port="reconhecido_em">reconhecido_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="reconhecido_por"><font color="#8A5A00">FK </font>reconhecido_por</td><td align="left"><font color="#5E6E7A">integer</font></td></tr></table>>];
configuracao [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#D9E8F5" colspan="2"><b>configuracao</b></td></tr><tr><td align="left" port="chave"><font color="#8A5A00">PK </font><b>chave</b></td><td align="left"><font color="#5E6E7A">varchar(40)</font></td></tr><tr><td align="left" port="valor">valor</td><td align="left"><font color="#5E6E7A">numeric</font></td></tr><tr><td align="left" port="unidade">unidade</td><td align="left"><font color="#5E6E7A">varchar(10)</font></td></tr><tr><td align="left" port="descricao">descricao</td><td align="left"><font color="#5E6E7A">varchar(200)</font></td></tr><tr><td align="left" port="alterado_em">alterado_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr></table>>];
usuario [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#F3DDE0" colspan="2"><b>usuario</b></td></tr><tr><td align="left" port="id_usuario"><font color="#8A5A00">PK </font><b>id_usuario</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="nome">nome</td><td align="left"><font color="#5E6E7A">varchar(100)</font></td></tr><tr><td align="left" port="login">login</td><td align="left"><font color="#5E6E7A">varchar(40)</font></td></tr><tr><td align="left" port="senha_hash">senha_hash</td><td align="left"><font color="#5E6E7A">text</font></td></tr><tr><td align="left" port="perfil">perfil</td><td align="left"><font color="#5E6E7A">varchar(12)</font></td></tr><tr><td align="left" port="id_cliente"><font color="#8A5A00">FK </font>id_cliente</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="ativo">ativo</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr><tr><td align="left" port="trocar_senha">trocar_senha</td><td align="left"><font color="#5E6E7A">boolean</font></td></tr><tr><td align="left" port="tentativas_falhas">tentativas_falhas</td><td align="left"><font color="#5E6E7A">smallint</font></td></tr><tr><td align="left" port="bloqueado_ate">bloqueado_ate</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="criado_em">criado_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="senha_alterada_em">senha_alterada_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="ultimo_login">ultimo_login</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr></table>>];
sessao [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#F3DDE0" colspan="2"><b>sessao</b></td></tr><tr><td align="left" port="id_sessao"><font color="#8A5A00">PK </font><b>id_sessao</b></td><td align="left"><font color="#5E6E7A">bigint</font></td></tr><tr><td align="left" port="token_hash">token_hash</td><td align="left"><font color="#5E6E7A">bytea</font></td></tr><tr><td align="left" port="id_usuario"><font color="#8A5A00">FK </font>id_usuario</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="criada_em">criada_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="ultimo_uso">ultimo_uso</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="expira_em">expira_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="encerrada_em">encerrada_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="ip">ip</td><td align="left"><font color="#5E6E7A">varchar(45)</font></td></tr><tr><td align="left" port="agente">agente</td><td align="left"><font color="#5E6E7A">varchar(200)</font></td></tr></table>>];
auditoria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#F3DDE0" colspan="2"><b>auditoria</b></td></tr><tr><td align="left" port="id_auditoria"><font color="#8A5A00">PK </font><b>id_auditoria</b></td><td align="left"><font color="#5E6E7A">bigint</font></td></tr><tr><td align="left" port="data_hora">data_hora</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="id_usuario">id_usuario</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="login">login</td><td align="left"><font color="#5E6E7A">varchar(40)</font></td></tr><tr><td align="left" port="ip">ip</td><td align="left"><font color="#5E6E7A">varchar(45)</font></td></tr><tr><td align="left" port="acao">acao</td><td align="left"><font color="#5E6E7A">varchar(30)</font></td></tr><tr><td align="left" port="tabela">tabela</td><td align="left"><font color="#5E6E7A">varchar(40)</font></td></tr><tr><td align="left" port="registro">registro</td><td align="left"><font color="#5E6E7A">varchar(60)</font></td></tr><tr><td align="left" port="antes">antes</td><td align="left"><font color="#5E6E7A">jsonb</font></td></tr><tr><td align="left" port="depois">depois</td><td align="left"><font color="#5E6E7A">jsonb</font></td></tr><tr><td align="left" port="detalhe">detalhe</td><td align="left"><font color="#5E6E7A">varchar(300)</font></td></tr><tr><td align="left" port="hash_anterior">hash_anterior</td><td align="left"><font color="#5E6E7A">bytea</font></td></tr><tr><td align="left" port="hash">hash</td><td align="left"><font color="#5E6E7A">bytea</font></td></tr></table>>];
log_backup [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#F3DDE0" colspan="2"><b>log_backup</b></td></tr><tr><td align="left" port="id_backup"><font color="#8A5A00">PK </font><b>id_backup</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="registrado_em">registrado_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="origem">origem</td><td align="left"><font color="#5E6E7A">varchar(12)</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#5E6E7A">varchar(8)</font></td></tr><tr><td align="left" port="arquivo">arquivo</td><td align="left"><font color="#5E6E7A">varchar(200)</font></td></tr><tr><td align="left" port="tamanho_bytes">tamanho_bytes</td><td align="left"><font color="#5E6E7A">bigint</font></td></tr><tr><td align="left" port="sha256">sha256</td><td align="left"><font color="#5E6E7A">char(64)</font></td></tr><tr><td align="left" port="duracao_ms">duracao_ms</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="mensagem">mensagem</td><td align="left"><font color="#5E6E7A">varchar(300)</font></td></tr><tr><td align="left" port="id_usuario"><font color="#8A5A00">FK </font>id_usuario</td><td align="left"><font color="#5E6E7A">integer</font></td></tr></table>>];
log_arquivamento [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#9AAAB6"><tr><td bgcolor="#DCEFE3" colspan="2"><b>log_arquivamento</b></td></tr><tr><td align="left" port="id_log"><font color="#8A5A00">PK </font><b>id_log</b></td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="executado_em">executado_em</td><td align="left"><font color="#5E6E7A">timestamptz</font></td></tr><tr><td align="left" port="particao">particao</td><td align="left"><font color="#5E6E7A">varchar(40)</font></td></tr><tr><td align="left" port="linhas_movidas">linhas_movidas</td><td align="left"><font color="#5E6E7A">bigint</font></td></tr><tr><td align="left" port="dias_resumidos">dias_resumidos</td><td align="left"><font color="#5E6E7A">integer</font></td></tr><tr><td align="left" port="duracao_ms">duracao_ms</td><td align="left"><font color="#5E6E7A">numeric(12,3)</font></td></tr></table>>];
cliente -> dispositivo:id_cliente;
dispositivo -> sensor:id_dispositivo;
dispositivo -> leitura:id_dispositivo;
dispositivo -> leitura_diaria:id_dispositivo;
dispositivo -> regra_alarme:id_dispositivo;
dispositivo -> evento:id_dispositivo;
regra_alarme -> evento:id_regra;
cliente -> usuario:id_cliente;
usuario -> sessao:id_usuario;
usuario -> log_backup:id_usuario;
usuario -> evento:reconhecido_por;
leitura -> leitura_arquivo [style=dashed, arrowhead=normal, label=" partição\n arquivada", fontsize=9, fontcolor="#4F616E"];
}